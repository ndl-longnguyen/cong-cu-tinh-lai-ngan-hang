# ==============================================================================
# BIẾN MÔI TRƯỜNG CẤU HÌNH HỆ THỐNG LÃI SUẤT NGÂN HÀNG VIỆT NAM
# ==============================================================================

# 1. Supabase PostgreSQL Database (Bắt buộc cho lưu trữ & rate sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
# Hoặc alias:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# SUPABASE_SERVICE_ROLE_KEY: Chỉ sử dụng ở Server-side cho Cron sync & Admin.
# TUYỆT ĐỐI KHÔNG prefix NEXT_PUBLIC_ cho key này!
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# 2. Google Gemini API (Dùng cho pipeline crawl & trích xuất lãi suất tự động)
GEMINI_API_KEY=your_google_gemini_api_key
# Model tối ưu cho Free Tier và hỗ trợ Google Search Grounding:
GEMINI_RATE_MODEL=gemini-2.5-flash-lite

# 3. Vercel Cron Security Secret (Bảo vệ endpoint /api/cron/update-bank-rates)
CRON_SECRET=your_random_secret_string_here

# 4. Canonical Site URL (Dùng cho SEO, OpenGraph và Sitemap)
NEXT_PUBLIC_SITE_URL=https://laisuatnganhang.vn
